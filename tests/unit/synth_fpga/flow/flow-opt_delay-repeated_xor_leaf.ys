# (a8 ^ a9) ^ (a8 ^ a10) ^ (a11 ^ a12) equals a9 ^ a10 ^ a11 ^ a12, because
# a8 cancels.  The XOR-tree rebalancing of -opt delay must drop a leaf that the
# tree reaches an even number of times instead of keeping it once, or the
# netlist computes a8 ^ a9 ^ a10 ^ a11 ^ a12.

read_verilog ../../data/designs/xor_repeat.v
proc
design -save rtl
synth_fpga -opt delay
rename top gate
design -copy-from rtl -as gold top
miter -equiv -flatten -make_assert gold gate miter
sat -verify -prove-asserts miter
